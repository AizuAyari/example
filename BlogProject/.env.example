# Copy this file to .env and fill in real values. Never commit .env.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY="change-me"

# True for local development only. Must be False (or unset) in production.
DEBUG=True

# Comma-separated list of allowed hostnames. In production, set this to your
# deployed domain (e.g. your-app.onrender.com) — never use a wildcard.
ALLOWED_HOSTS=localhost,127.0.0.1
